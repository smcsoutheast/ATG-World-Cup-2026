name: Update Score Feed

on:
  workflow_dispatch:
  schedule:
    - cron: "*/10 * * * *"

permissions:
  contents: write

jobs:
  update-score-feed:
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Update score-feed.json
        env:
          SCORE_API_PROVIDER: ${{ secrets.SCORE_API_PROVIDER }}
          SCORE_API_KEY: ${{ secrets.SCORE_API_KEY }}
          SCORE_API_BASE_URL: ${{ secrets.SCORE_API_BASE_URL }}
          SCORE_API_COMPETITION_ID: ${{ secrets.SCORE_API_COMPETITION_ID }}
          SCORE_API_SEASON: ${{ secrets.SCORE_API_SEASON }}
        run: node scripts/update-score-feed.js

      - name: Commit updated score feed
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "Update score feed"
          file_pattern: score-feed.json
